# =====================================================================
# CAMADA RAW — bases brutas de terceiros, NAO redistribuidas
# =====================================================================
data/raw/*
!data/raw/MANIFEST.md
!data/raw/.gitkeep

# =====================================================================
# CACHES INTERMEDIARIOS
# Regeneraveis, porem custosos. Ver secao "Caches intermediarios" do README:
# recomenda-se deposita-los no Zenodo como registro Dataset separado.
# =====================================================================
data/interim/*
!data/interim/.gitkeep

# Draws de bootstrap (1500 replicas) — regeneravel pela semente declarada
*bootstrap_draws.parquet
previous_land_use_grid_year_long.parquet

